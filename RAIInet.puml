@startuml

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam packageStyle rectangle
hide empty members

class PieceId {
  +int value
}
class Position {
  +int row
  +int col
}
class Target {
  +variant<PieceId, Position> value
}
abstract class Ability {
  +int Owner
  +bool use(Board&, Player& user, const Target&)
}
class SwapAbility
class LinkBoost
class DownloadAbility
class PolarizeAbility
class ScanAbility
class BlockadeAbility
class DiagonalAbility
class FirewallAbility {
  +bool use(Board&, Player& user, const Target&)
}

class Game {
  +vector<Player> players
  +Board board
  +int currentPlayer
  +bool abilityUsedThisTurn
  +vector<unique_ptr<Ability>> abilities
  +bool move(PieceId, Direction)
  +bool useAbility(int, Target)
  +void handleCommand(Command)
  +void checkWin()
}
class Player {
  +int id
  +int downloadedData
  +int downloadedViruses
}
class Board {
  +vector<Piece> pieces
  +Square[8][8] squares
  +Square& at(Position)
  +Position findPiece(PieceId) const
  +Piece& getPiece(PieceId)
  +void download(PieceId, Player& recipient)
  +EntryResult enterTerrain(Position destination, PieceId mover, vector<Player>& players)
}
class Piece {
  +PieceId id
  +int owner
  +PieceType type
  +int strength
  +set<Move> moveset
  +map<int, bool> visibility
  +bool isVisibleTo(int player)
  +void revealTo(int player)
}
class Move {
  +int dx
  +int dy
}
enum PieceType {
  Data
  Virus
}
class Square {
  +optional<PieceId> occupant
  +Terrain terrain = Regular
  +optional<int> owner
  +unique_ptr<SquareEffect> effect
}
enum Terrain {
  Regular
  Server
  Blockade
}
abstract class SquareEffect {
  +{abstract} optional<int> onEnter(Piece& entering)
}
class Firewall {
  +Firewall(int owner)
  +int owner
  +optional<int> onEnter(Piece& entering)
}
enum EntryResult {
  Blocked
  Continue
  Downloaded
}

abstract class Subject {
  -vector<Observer*> observers
  +void attach(Observer*)
  +void detach(Observer*)
  +void notifyObservers()
}
abstract class Observer {
  +void notify()
}
abstract class View {
  #Game& game
  #int viewpoint
  +void notify()
  +void render()
}
class GraphicsDisplay {
  +void render()
}
class TextDisplay {
  +void render()
}
class CommandInterpreter {
  +void run()
  +Command parse(string)
}
class Command {
  +CommandType type
  +PieceId piece
  +Direction direction
  +int abilityId
  +Target target
}
enum CommandType {
  Move
  Ability
  Board
  Abilities
  Sequence
  Quit
}
enum Direction {
  Up
  Down
  Left
  Right
}

SwapAbility --|> Ability
LinkBoost --|> Ability
DownloadAbility --|> Ability
PolarizeAbility --|> Ability
ScanAbility --|> Ability
BlockadeAbility --|> Ability
DiagonalAbility --|> Ability
FirewallAbility -up-|> Ability
Ability ..> Target : uses
Ability ..> Board : modifies
Ability ..> Player : uses
Target .up.> PieceId
Target .up.> Position

Game "1" *-- "2" Player
Game "1" *-- "1" Board
Board "1" *-- "0..16" Piece
Game "1" *-up- "0..*" Ability
Board "1" *-- "64" Square
Piece "1" *-right- "0..*" Move
Piece -right-> PieceType
Square -left-> Terrain
Square ..> PieceId
Square "1" *-- "0..1" SquareEffect
Firewall --|> SquareEffect
FirewallAbility ..> Firewall : places
SquareEffect ..> Piece
Board ..> EntryResult
Board ..> Player

Game --|> Subject
Subject o-- "0..*" Observer
View --|> Observer
GraphicsDisplay --|> View
TextDisplay --|> View
View --> Game : reads state
CommandInterpreter --> Game
CommandInterpreter ..> Command
Command --> CommandType
Command --> Direction
@enduml
