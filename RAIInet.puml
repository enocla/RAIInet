@startuml

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam packageStyle rectangle
hide empty members

class PieceId {
  +int value
}
class PlayerId {
  +int value
}
class Position {
  +int row
  +int col
}
class Target {
  +variant<PieceId, Position> value
}
abstract class Ability {
  +PlayerId owner
  +bool use(Board&, Player& user, const Target&)
}
class SwapAbility
class LinkBoost
class DownloadAbility
class PolarizeAbility
class ScanAbility
class BlockadeAbility
class DiagonalAbility
class FirewallAbility {
  +bool use(Board&, Player& user, const Target&)
}

class Game {
  +vector<Player> players
  +Board board
  +PlayerId currentPlayer
  +bool abilityUsedThisTurn
  +vector<unique_ptr<Ability>> abilities
  +Player& player(PlayerId)
  +bool move(PieceId, Direction)
  +bool useAbility(int, Target)
  +void handleCommand(Command)
  +void checkWin()
}
class Player {
  +PlayerId id
  +int downloadedData
  +int downloadedViruses
}
class Board {
  +vector<Piece> pieces
  +Square[8][8] squares
  +Square& at(Position)
  +Position findPiece(PieceId) const
  +Piece& getPiece(PieceId)
  +void download(PieceId, Player& recipient)
}
class Piece {
  +PieceId id
  +PlayerId owner
  +PieceType type
  +int strength
  +set<Move> moveset
  +map<PlayerId, bool> visibility
  +bool isVisibleTo(PlayerId player)
  +void revealTo(PlayerId player)
}
class Move {
  +int dx
  +int dy
}
enum PieceType {
  Data
  Virus
}
class Square {
  +optional<PieceId> occupant
  +unique_ptr<SquareEffect> effect
}
abstract class SquareEffect {
  +bool blocking(const Piece& entering) const
  +{abstract} optional<PlayerId> onEnter(Piece& entering)
  +{abstract} DisplayEffectInfo getDisplayInfo() const
}
class Firewall {
  +Firewall(PlayerId owner)
  +PlayerId owner
  +optional<PlayerId> onEnter(Piece& entering)
  +DisplayEffectInfo getDisplayInfo() const
}
class ServerPort {
  +PlayerId owner
  +bool blocking(const Piece& entering) const
  +optional<PlayerId> onEnter(Piece& entering)
  +DisplayEffectInfo getDisplayInfo() const
}
class Blockade {
  +bool blocking(const Piece& entering) const
  +optional<PlayerId> onEnter(Piece& entering)
  +DisplayEffectInfo getDisplayInfo() const
}
enum DisplayEffectKind {
  ServerPort
  Firewall
  Blockade
}
class DisplayEffectInfo {
  +DisplayEffectKind kind
  +optional<PlayerId> owner
}

abstract class Subject {
  -vector<Observer*> observers
  +void attach(Observer*)
  +void detach(Observer*)
  +void notifyObservers()
}
abstract class Observer {
  +void notify()
}
abstract class View {
  #Game& game
  #PlayerId viewpoint
  +void notify()
  +void render()
}
class GraphicsDisplay {
  +void render()
}
class TextDisplay {
  +void render()
}
class CommandInterpreter {
  +void run()
  +Command parse(string)
}
class Command {
  +CommandType type
  +PieceId piece
  +Direction direction
  +int abilityId
  +Target target
}
enum CommandType {
  Move
  Ability
  Board
  Abilities
  Sequence
  Quit
}
enum Direction {
  Up
  Down
  Left
  Right
}

SwapAbility --|> Ability
LinkBoost --|> Ability
DownloadAbility --|> Ability
PolarizeAbility --|> Ability
ScanAbility --|> Ability
BlockadeAbility --|> Ability
DiagonalAbility --|> Ability
FirewallAbility -up-|> Ability
Ability ..> Target : uses
Ability ..> Board : modifies
Ability ..> Player : uses
Target .up.> PieceId
Piece --> PlayerId : owner
Player --> PlayerId : id
Target .up.> Position

Game "1" *-- "2" Player
Game "1" *-- "1" Board
Board "1" *-- "0..16" Piece
Game "1" *-up- "0..*" Ability
Board "1" *-- "64" Square
Piece "1" *-right- "0..*" Move
Piece -right-> PieceType
Square ..> PieceId
Square "1" *-- "0..1" SquareEffect
Firewall --|> SquareEffect
ServerPort --|> SquareEffect
Blockade --|> SquareEffect
FirewallAbility ..> Firewall : places
BlockadeAbility ..> Blockade : places
SquareEffect ..> Piece
SquareEffect ..> DisplayEffectInfo
DisplayEffectInfo --> DisplayEffectKind
View ..> DisplayEffectInfo : draws
Board ..> Player

Game --|> Subject
Subject o-- "0..*" Observer
View --|> Observer
GraphicsDisplay --|> View
TextDisplay --|> View
View --> Game : reads state
CommandInterpreter --> Game
CommandInterpreter ..> Command
Command --> CommandType
Command --> Direction
@enduml
